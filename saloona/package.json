{
  "name": "saloona",
  "private": true,
  "version": "1.0.0",
  "description": "Kundebog til en hjemmefrisør. Offline Android-app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --mode web --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "android:sync": "vite build && cap sync android",
    "build:web": "vite build --mode web"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "sql.js": "1.14.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
