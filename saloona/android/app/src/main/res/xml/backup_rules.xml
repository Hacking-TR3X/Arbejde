<?xml version="1.0" encoding="utf-8"?>
<!--
  android:fullBackupContent (Android 11 and lower).
  allowBackup="false" already turns backup off; this file excludes everything
  as a second line of defence. The database is encrypted with a Keystore key
  that never leaves the phone, so a Google backup would be useless and only an
  extra copy of personal data. Backup is done on purpose via export.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
