<?xml version="1.0" encoding="utf-8"?>
<!--
  The app has no INTERNET permission and makes no network requests. This config
  is defence in depth: no cleartext traffic, and only system CAs (no user-added
  certificates) if anything ever did try to connect.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
