<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dashcam" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dash_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#B2DFDB</item>
        <item name="colorOnPrimaryContainer">#00201C</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Dashcam.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#4DB6AC</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
