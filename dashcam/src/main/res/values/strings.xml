    <!-- Skift kode -->
    <string name="change_pw_title">Skift kameraets Wi‑Fi-kode</string>
    <string name="change_pw_message">Eksperimentelt. Den nye kode sendes til kameraet og gemmes i appen. Genstart kameraet bagefter.\n\nGår noget galt, så nulstil kameraet til fabriksindstillinger i dets menu – så bør koden blive 1234567890 igen.\n\nBrug 8–16 tegn: kun bogstaver a–z og tal.</string>
